---
interface Props {
	date: Date;
}

const { date } = Astro.props;
const formattedDate = date.toLocaleDateString("en-GB", {
	day: "2-digit",
	month: "short",
	year: "2-digit",
	timeZone: "UTC",
});
const altFormattedDate = date.toLocaleDateString("en-GB", {
	hour: "2-digit",
	minute: "2-digit",
	day: "2-digit",
	month: "short",
	year: "2-digit",
	timeZoneName: "short",
	timeZone: "UTC",
});
---

<time datetime={date.toISOString()} title={altFormattedDate}>
	{formattedDate}
</time>
