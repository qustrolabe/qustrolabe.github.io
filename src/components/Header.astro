---
import { SITE_TITLE } from "@consts";
import HeaderLink from "@components/HeaderLink.astro";
import { Icon } from "astro-icon/components";
import SiteIcon from "@assets/icon.svg";
---

<header
	class="min-h-10 w-[768px] max-w-[calc(100%-2em)] mx-auto px-[1.5em] max-[48em]:max-w-full max-[48em]:px-[0.75em]"
>
	<div class="flex items-center justify-between gap-4 pt-2 pb-2">
		<div class="flex items-center gap-2 shrink-0">
			<SiteIcon class="w-12 h-12" />
			<span class="text-lg font-semibold">{SITE_TITLE}</span>
		</div>
		<div class="flex gap-3 shrink-0" aria-label="Social links">
			<a
				href="https://github.com/qustrolabe"
				aria-label="GitHub"
				target="_blank"
				rel="me noopener noreferrer"
				title="GitHub"
				class="p-1 hover:text-[var(--color-highlight)] focus-visible:text-[var(--color-highlight)]"
			>
				<Icon name="mdi:github" width="20" height="20" />
			</a>
			<a
				href="https://x.com/qustrolabe"
				aria-label="X / Twitter"
				target="_blank"
				rel="me noopener noreferrer"
				title="X / Twitter"
				class="p-1 hover:text-[var(--color-highlight)] focus-visible:text-[var(--color-highlight)]"
			>
				<Icon name="mdi:twitter" width="18" height="18" />
			</a>
			<a
				href="https://bsky.app/profile/qustrolabe.bsky.social"
				aria-label="Bluesky"
				target="_blank"
				rel="me noopener noreferrer"
				title="Bluesky"
				class="p-1 hover:text-[var(--color-highlight)] focus-visible:text-[var(--color-highlight)]"
			>
				<Icon name="simple-icons:bluesky" width="18" height="18" />
			</a>
			<a
				href="https://t.me/qustrolabe"
				aria-label="Telegram"
				target="_blank"
				rel="me noopener noreferrer"
				title="Telegram"
				class="p-1 hover:text-[var(--color-highlight)] focus-visible:text-[var(--color-highlight)]"
			>
				<Icon name="simple-icons:telegram" width="18" height="18" />
			</a>
		</div>
	</div>
	<nav class="flex flex-wrap items-center gap-1 justify-start pb-2">
		<HeaderLink href="/" class="px-2 !no-underline text-sm">Home</HeaderLink>
		<HeaderLink href="/blog/" class="px-2 !no-underline text-sm">Blog</HeaderLink>
		<HeaderLink href="/projects/" class="px-2 !no-underline text-sm"
			>Projects</HeaderLink
		>
		<HeaderLink href="/about/" class="px-2 !no-underline text-sm">About</HeaderLink>
	</nav>
	<hr class="border-surface-border/60" />
</header>
