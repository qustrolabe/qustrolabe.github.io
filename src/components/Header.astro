---
import { SITE_TITLE } from "@consts";
import HeaderLink from "@components/HeaderLink.astro";
import { Icon } from "astro-icon/components";
import SiteIcon from "@assets/icon.webp";
import { Image } from "astro:assets";

const normalizePath = (path: string) =>
	path !== "/" ? path.replace(/\/+$/, "") : "/";

const isHomeActive = normalizePath(Astro.url.pathname) === "/";
---

<header
	class="mx-auto min-h-10 max-w-[768px] px-[1.5em] max-[48em]:max-w-full max-[48em]:px-[0.75em]"
>
	<div class="flex flex-wrap items-center justify-between gap-4 py-2">
		<a
			href="/"
			aria-label="Home"
			class:list={[
				"inline-flex items-center gap-2 shrink-0 !no-underline border-b-2 border-transparent",
				isHomeActive &&
					"text-[var(--color-highlight)] border-[var(--color-highlight)]",
				"hover:text-[var(--color-highlight)]",
			]}
		>
			<Image
				src={SiteIcon}
				width={256}
				height={256}
				class="inline-block size-12 shrink-0"
				alt=""
			/>
			<span class="text-lg leading-none font-semibold">{SITE_TITLE}</span>
		</a>
		<div
			class="flex flex-wrap items-center gap-3"
			aria-label="Social links"
		>
			<a
				href="https://github.com/qustrolabe"
				aria-label="GitHub"
				target="_blank"
				rel="me noopener noreferrer"
				title="GitHub"
				class="p-1 hover:text-highlight focus-visible:text-highlight"
			>
				<Icon name="mdi:github" width="20" height="20" />
			</a>
			<a
				href="https://x.com/qustrolabe"
				aria-label="X / Twitter"
				target="_blank"
				rel="me noopener noreferrer"
				title="X / Twitter"
				class="p-1 hover:text-highlight focus-visible:text-highlight"
			>
				<Icon name="mdi:twitter" width="18" height="18" />
			</a>
			<a
				href="https://bsky.app/profile/qustrolabe.bsky.social"
				aria-label="Bluesky"
				target="_blank"
				rel="me noopener noreferrer"
				title="Bluesky"
				class="p-1 hover:text-highlight focus-visible:text-highlight"
			>
				<Icon name="simple-icons:bluesky" width="18" height="18" />
			</a>
			<a
				href="https://t.me/qustrolabe"
				aria-label="Telegram"
				target="_blank"
				rel="me noopener noreferrer"
				title="Telegram"
				class="p-1 hover:text-highlight focus-visible:text-highlight"
			>
				<Icon name="simple-icons:telegram" width="18" height="18" />
			</a>
		</div>
	</div>
	<nav class="flex flex-wrap items-center justify-start gap-1 pb-2">
		<HeaderLink href="/blog/" class="px-2 text-sm no-underline!"
			>Blog</HeaderLink
		>
		<HeaderLink href="/projects/" class="px-2 text-sm no-underline!"
			>Projects</HeaderLink
		>
		<HeaderLink href="/about/" class="px-2 text-sm no-underline!"
			>About</HeaderLink
		>
		<!-- <HeaderLink href="/recommendations/" class="px-2 no-underline! text-sm"
			>Recommendations</HeaderLink
		> -->
	</nav>
	<hr class="border-surface-border/60" />
</header>
