---
import { SITE_TITLE } from "@consts";
import HeaderLink from "@components/HeaderLink.astro";
---

<header
	class="flex bg-surface border-surface-border h-10 justify-center border-b overflow-hidden"
>
	<nav class="w-full">
		<div
			class="w-full internal-links flex flex-nowrap justify-center gap-1"
		>
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<!-- <HeaderLink href="/contact">Contact</HeaderLink> -->
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		/* background: white; */
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	/* h2 {
		margin: 0;
		font-size: 1em;
	} */

	/* h2 a,
	h2 a.active {
		text-decoration: none;
	} */
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 0em 0.5em;
		color: var(--black);
		/* border-bottom: 1px solid transparent; */
		text-decoration: none;
	}

	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
