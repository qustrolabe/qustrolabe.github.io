---
import { Image } from "astro:assets";
import FormattedDate from "./FormattedDate.astro";

interface Props {
    id: string;
    title: string;
    description: string;
    pubDate: Date;
}

const { pubDate, title, id, description } = Astro.props;
---

<li class="flex">
    <a
        href={`/blog/${id}`}
        class="group m-1 w-full p-2 text-white no-underline! hover:text-highlight! active:text-highlight!"
    >
        <p class="text-sm text-gray-200 group-hover:text-highlight! group-active:text-highlight!">
            <FormattedDate date={pubDate} />
        </p>
        <h1 class="text-xl">
            {title}
        </h1>
        <p class="truncate overflow-hidden text-sm text-ellipsis whitespace-nowrap text-gray-400">
            {description}
        </p>
    </a>
</li>
