---
import { Icon } from "astro-icon/components";

interface Props {
    /** Tool name shown in the card header */
    title: string;
    /** One line explaining what the tool does */
    description?: string;
    /** Iconify icon id (e.g. "mdi:github"), shown next to the title */
    icon?: string;
    /** When set, the whole card links here */
    href?: string;
}

const { title, description, icon, href } = Astro.props;
---

<div
    class="relative flex h-full flex-col rounded-lg border border-surface-border transition-colors focus-within:border-highlight hover:border-highlight"
>
    <div class="flex flex-1 flex-col gap-1 p-4">
        <span class="flex items-center gap-2 font-semibold">
            {icon && <Icon name={icon} width="18" height="18" class="shrink-0 opacity-60" />}
            {title}
        </span>
        {description && <span class="text-sm/snug text-neutral-400">{description}</span>}
        {href && <span class="mt-auto pt-2 text-sm">open tool</span>}
    </div>
    {
        href && (
            <a
                href={href}
                aria-label={`Open ${title}`}
                class="absolute inset-0 z-0 rounded-lg after:content-none!"
            />
        )
    }
</div>
