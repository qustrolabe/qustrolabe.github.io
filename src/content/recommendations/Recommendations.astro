---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { recommendations, type Recommendation } from "./data";

const images = import.meta.glob<ImageMetadata>(
    "../../assets/recommendations/*.{webp,avif,png,jpg,jpeg,svg}",
    { eager: true },
);

const getImage = (fileName?: string): ImageMetadata | undefined => {
    if (!fileName) return undefined;
    const image = images[`../../assets/recommendations/${fileName}`];
    if (!image) {
        throw new Error(
            `Recommendation image "${fileName}" not found in src/assets/recommendations/`,
        );
    }
    return image;
};

const typeIcons: Record<Recommendation["type"], string> = {
    Movie: "mdi:movie-open",
    "Animated Movie": "mdi:filmstrip",
    "TV Series": "mdi:television-classic",
    "Animated Series": "mdi:animation",
    Anime: "mdi:animation-play",
    Book: "mdi:book",
    Novel: "mdi:book-alphabet",
    Manga: "mdi:book-open-variant",
    Manhwa: "mdi:book-open-page-variant",
    Webcomic: "mdi:web",
    "Video Game": "mdi:gamepad-variant",
    Music: "mdi:music",
    Other: "mdi:star",
};
---

<ul class="m-0! list-none! columns-2 gap-4 p-0! sm:columns-3">
    {
        recommendations.map((rec) => {
            const image = getImage(rec.image);
            return (
                <li class="mb-4 break-inside-avoid">
                    <div class="relative overflow-hidden rounded-lg border border-surface-border transition-colors focus-within:border-highlight hover:border-highlight">
                        {image && (
                            <Image
                                src={image}
                                alt=""
                                class="w-full border-b border-surface-border"
                                loading="lazy"
                            />
                        )}
                        {image ? (
                            <Image
                                src={image}
                                alt=""
                                class="w-full border-b border-surface-border"
                                loading="lazy"
                            />
                        ) : (
                            <div class="flex aspect-2/1 w-full items-center justify-center border-b border-surface-border bg-surface">
                                <Icon
                                    name={typeIcons[rec.type]}
                                    width="28"
                                    height="28"
                                    class="opacity-30"
                                />
                            </div>
                        )}
                        <div class="flex flex-col gap-0.5 p-3">
                            <span class="leading-tight font-semibold">{rec.name}</span>
                            <span class="text-xs tracking-wide text-neutral-400 uppercase">
                                {rec.type}
                                {rec.year && ` · ${rec.year}`}
                                {rec.rating !== undefined && (
                                    <span class="text-highlight"> · ★ {rec.rating}</span>
                                )}
                            </span>
                            {rec.description && (
                                <span class="mt-1 text-sm/snug text-neutral-400">
                                    {rec.description}
                                </span>
                            )}
                        </div>
                        {rec.link && (
                            <a
                                href={rec.link}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={`Open ${rec.name}`}
                                class="absolute inset-0 z-0 after:content-none!"
                            />
                        )}
                    </div>
                </li>
            );
        })
    }
</ul>
