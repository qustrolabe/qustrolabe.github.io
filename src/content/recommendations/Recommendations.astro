---
import { Icon } from "astro-icon/components";
import { Image, type ImageMetadata } from "astro:assets";
import { recommendations, type Recommendation } from "./data";

const images = import.meta.glob<ImageMetadata>(
    "../../assets/recommendations/*.{webp,avif,png,jpg,jpeg,svg}",
    { eager: true },
);

const getImage = (fileName?: string): ImageMetadata | undefined => {
    if (!fileName) return undefined;
    const image = images[`../../assets/recommendations/${fileName}`];
    if (!image) {
        throw new Error(
            `Recommendation image "${fileName}" not found in src/assets/recommendations/`,
        );
    }
    return image;
};

const typeIcons: Record<Recommendation["type"], string> = {
    Movie: "mdi:movie-open",
    "Animated Movie": "mdi:filmstrip",
    "TV Series": "mdi:television-classic",
    "Animated Series": "mdi:animation",
    Anime: "mdi:animation-play",
    Book: "mdi:book",
    Novel: "mdi:book-alphabet",
    Manga: "mdi:book-open-variant",
    Manhwa: "mdi:book-open-page-variant",
    Webcomic: "mdi:web",
    "Video Game": "mdi:gamepad-variant",
    Music: "mdi:music",
    Other: "mdi:star",
};
---

<ul class="columns-2 gap-4 sm:columns-3 list-none! p-0! m-0!">
    {
        recommendations.map((rec) => {
            const image = getImage(rec.image);
            return (
                <li class="mb-4 break-inside-avoid">
                    <div class="relative overflow-hidden rounded-lg border border-surface-border transition-colors hover:border-highlight focus-within:border-highlight">
                        {image && (
                            <Image
                                src={image}
                                alt=""
                                class="w-full border-b border-surface-border"
                                loading="lazy"
                            />
                        )}
                        <div class="flex flex-col gap-0.5 p-3">
                            <span class="flex items-center gap-1.5 font-semibold leading-tight">
                                {!image && (
                                    <Icon
                                        name={typeIcons[rec.type]}
                                        width="14"
                                        height="14"
                                        class="shrink-0 opacity-60"
                                    />
                                )}
                                {rec.name}
                            </span>
                            <span class="text-xs text-neutral-400 tracking-wide uppercase">
                                {rec.type}
                                {rec.year && ` · ${rec.year}`}
                                {rec.rating !== undefined && (
                                    <span class="text-[var(--color-highlight)]">
                                        {" "}
                                        · ★ {rec.rating}
                                    </span>
                                )}
                            </span>
                            {rec.description && (
                                <span class="mt-1 text-sm text-neutral-400 leading-snug">
                                    {rec.description}
                                </span>
                            )}
                        </div>
                        {rec.link && (
                            <a
                                href={rec.link}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={`Open ${rec.name}`}
                                class="absolute inset-0 z-0 after:content-none!"
                            />
                        )}
                    </div>
                </li>
            );
        })
    }
</ul>
