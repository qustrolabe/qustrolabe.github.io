---
import ToolCard from "@components/ToolCard.astro";
import { tools } from "./data";
---

<ul class="m-0! grid list-none! gap-4 p-0! sm:grid-cols-2">
    {
        tools.map((tool) => (
            <li>
                <ToolCard
                    title={tool.name}
                    description={tool.description}
                    icon={tool.icon}
                    href={`/tools/${tool.slug}/`}
                />
            </li>
        ))
    }
</ul>
