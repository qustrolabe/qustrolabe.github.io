---
import Head from "@components/Head.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import "@styles/global.css";

interface Props {
    title: string;
    description: string;
    /**
     * When true, the page will provide its own <main> / layout wrapper.
     * When false (default), this layout wraps content in the standard main container.
     */
    customMain?: boolean;
}

const { title, description, customMain = false } = Astro.props;
---

<html lang="en" class="" transition:animate="none">
    <Head title={title} description={description} />

    <!-- `dvh` rather than `vh`: 100vh is the height with mobile browser chrome
         hidden, so a `vh` minimum is always slightly taller than the visible
         area and leaves a sliver of scroll on pages shorter than the screen. -->
    <body class="flex min-h-dvh flex-col bg-background text-foreground">
        <Header />
        {
            customMain ? (
                <slot />
            ) : (
                <main class="mx-auto w-[768px] max-w-[calc(100%-2em)] flex-1 px-[1.5em] pt-4 pb-8 max-[48em]:max-w-full max-[48em]:px-[0.75em]">
                    <slot />
                </main>
            )
        }
        <Footer />
    </body>
</html>
