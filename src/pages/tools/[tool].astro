---
import type { GetStaticPaths } from "astro";
import MainLayout from "@layouts/MainLayout.astro";
import GithubRepoSize from "@components/GithubRepoSize.tsx";
import { tools, type Tool } from "@content/tools/data";

export const getStaticPaths = (() =>
    tools.map((tool) => ({
        params: { tool: tool.slug },
        props: { tool },
    }))) satisfies GetStaticPaths;

const { tool } = Astro.props as { tool: Tool };
---

<MainLayout title={tool.name} description={tool.description}>
    <h1 class="mb-0.5 text-xl font-semibold">{tool.name}</h1>
    <p class="mb-4 text-sm text-neutral-400">{tool.description}</p>
    <!-- Rendered from an explicit reference: a `components[tool.slug]` lookup
         leaves Astro unable to tell which island to hydrate, since the client
         side island only knows the module URL and the export name. -->
    {tool.slug === "github-repo-size" && <GithubRepoSize client:load />}
</MainLayout>
